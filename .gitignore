/target
# Runtime state Argus writes into a checkout: linked worktrees it created,
# and per-boot agent status hooks (port + bearer token, meaningless after
# the daemon that wrote them exits).
/.argus/
.claude/settings.local.json
.codex/hooks.json
.opencode/plugin/argus-status.js
.cursor/hooks.json
.cursor/rules/argus.mdc
cov.xml
# tauri-build writes its schemas here on every build.
crates/argus-desktop/gen/

# Sidecars the desktop bundle copies in, staged by the bundle step (tauri.bundle.conf.json).
/crates/argus-desktop/binaries/

# reliab reports and tool output (written only by reliab)
.reliab/
