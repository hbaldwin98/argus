{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "src/bindings/**",
    "test/contract/sent.ts",
    "node_modules/**"
  ],
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__TAURI__"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "test/screens/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
